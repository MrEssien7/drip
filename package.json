{
  "name": "drip",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "hook": "cargo build --release -p drip-hook",
    "icons": "rustc -O --edition 2021 scripts/gen_icon.rs -o target/gen_icon.exe && target\\gen_icon.exe src-tauri/icons/source.png && tauri icon src-tauri/icons/source.png -o src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5",
    "@fontsource/ibm-plex-sans": "^5",
    "@tauri-apps/api": "^2"
  }
}
